# Environment local Docker — copier vers .env.local puis remplacer les placeholders localement.
# Ne jamais committer .env.local ni utiliser ces valeurs en production.
DATABASE_URL=postgresql://it_manager:<LOCAL_SECRET>@postgres:5432/it_infrastructure
POSTGRES_DB=it_infrastructure
POSTGRES_USER=it_manager
POSTGRES_PASSWORD=<LOCAL_SECRET>
JWT_SECRET=<LOCAL_SECRET>
OAUTH_SERVER_URL=https://api.manus.im
# Facultatif pour ouvrir l’interface locale ; requis uniquement pour activer OAuth.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=https://manus.im
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_TIMEOUT_MS=3000
MONITORING_ENABLED=true
